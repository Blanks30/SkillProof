# ==========================================
# SkillProof Environment Configuration
# ==========================================

# Database Connection (SQLite for easy zero-setup local dev, or PostgreSQL)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/skillproof?schema=public"

# Next.js Server
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="skillproof-super-secure-production-ready-jwt-secret-key-32chars"

# Blockchain Configuration (Polygon Amoy Testnet & Localhost)
NEXT_PUBLIC_CHAIN_ID="80002"
NEXT_PUBLIC_NETWORK_NAME="Polygon Amoy Testnet"
NEXT_PUBLIC_RPC_URL="https://rpc-amoy.polygon.technology"
NEXT_PUBLIC_BLOCK_EXPLORER="https://amoy.polygonscan.com"

# Smart Contract Address (Deployed SkillProofRegistry.sol)
NEXT_PUBLIC_CONTRACT_ADDRESS="0x71C8F7A853245B11C194f48A141d6D33a0E821Db"

# Private key for backend issuer relayer / deployment (NEVER commit a real private key)
PRIVATE_KEY="your_private_key_without_0x_or_leave_empty_for_mock_ledger"

# IPFS Pinning Service (Optional, for decentralized PDF storage: Pinata or Web3.Storage)
PINATA_API_KEY=""
PINATA_API_SECRET=""
PINATA_JWT=""
NEXT_PUBLIC_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs/"
